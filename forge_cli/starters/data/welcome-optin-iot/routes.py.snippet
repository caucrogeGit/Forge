# forge-starter:welcome-optin-iot:start
from mvc.controllers.welcome_optin_iot_controller import WelcomeIotController
from optins.registry import register_optins

with router.group("", public=True) as pub:
    pub.add("GET", "/welcome-optin-iot",                            WelcomeIotController.index,          name="welcome_optin_iot_index")
    pub.add("GET", "/welcome-optin-iot/inspect",                    WelcomeIotController.inspect,        name="welcome_optin_iot_inspect")
    pub.add("GET", "/welcome-optin-iot/events",                     WelcomeIotController.events,         name="welcome_optin_iot_events")
    pub.add("GET", "/welcome-optin-iot/device/{site}/{device_id}",  WelcomeIotController.find_by_device, name="welcome_optin_iot_find_by_device")

# Branchement local des opt-ins — explicite, sans découverte automatique.
# register_optins() est défini dans optins/registry.py et délègue à
# optins/iot/routes.py, qui appelle register_iot_routes(router) (API HTTP
# IoT officielle, lecture seule). Le parcours pédagogique /welcome-optin-iot/*
# ci-dessus reste indépendant.
register_optins(router)
# forge-starter:welcome-optin-iot:end
