{
  "$schema": "../../../../schemas/entity.schema.json",
  "schema_version": "1.0",
  "name": "Contact",
  "table": "contact",
  "description": "Contacts — starter niveau 1",
  "fields": [
    {
      "name": "nom",
      "type": "string",
      "max_length": 80,
      "nullable": false
    },
    {
      "name": "prenom",
      "type": "string",
      "max_length": 80,
      "nullable": false
    },
    {
      "name": "email",
      "type": "string",
      "max_length": 120,
      "unique": true,
      "nullable": false
    },
    {
      "name": "telephone",
      "type": "string",
      "max_length": 20,
      "nullable": true
    }
  ],
  "options": {
    "timestamps": false,
    "soft_delete": false
  }
}
