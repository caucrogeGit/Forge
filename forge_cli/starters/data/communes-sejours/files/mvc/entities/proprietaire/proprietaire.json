{
  "$schema": "../../../../../../../../schemas/entity.schema.json",
  "schema_version": "1.0",
  "name": "Proprietaire",
  "table": "proprietaire",
  "description": "Propriétaire ou gestionnaire d'un hébergement",
  "fields": [
