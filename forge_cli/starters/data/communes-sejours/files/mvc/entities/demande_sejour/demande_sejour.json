      "sql_type": "INT",
      "nullable": true
    },
    {
      "name": "nom",
      "sql_type": "VARCHAR(100)",
      "constraints": {
        "not_empty": true,
        "max_length": 100
      }
    },
    {
      "name": "email",
      "sql_type": "VARCHAR(120)",
      "constraints": {
        "not_empty": true,
        "max_length": 120
      }
    },
    {
      "name": "telephone",
      "sql_type": "VARCHAR(20)",
      "nullable": true,
      "constraints": {
        "max_length": 20
      }
    },
    {
      "name": "message",
      "sql_type": "TEXT",
      "nullable": true
    },
    {
      "name": "date_arrivee",
      "sql_type": "DATE",
      "nullable": true
    },
    {
      "name": "date_depart",
      "sql_type": "DATE",
      "nullable": true
    },
    {
      "name": "nombre_personnes",
      "sql_type": "INT",
      "nullable": true
    },
    {
      "name": "statut",
      "sql_type": "VARCHAR(30)",
      "default": "nouveau",
      "constraints": {
        "not_empty": true,
        "max_length": 30
      }
    },
    {
      "name": "created_at",
      "sql_type": "DATETIME",
      "nullable": true
    }
  ]
}
