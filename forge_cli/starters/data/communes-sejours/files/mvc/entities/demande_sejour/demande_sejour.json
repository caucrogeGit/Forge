{
  "$schema": "../../../../../../../../schemas/entity.schema.json",
  "schema_version": "1.0",
  "name": "DemandeSejour",
  "table": "demande_sejour",
  "description": "Demande de contact ou de séjour envoyée par un visiteur",
  "fields": [
    { "name": "hebergement_id",  "type": "integer", "nullable": true },
    { "name": "nom",             "type": "string",  "max_length": 100, "nullable": false },
    { "name": "email",           "type": "string",  "max_length": 120, "nullable": false },
    { "name": "telephone",       "type": "string",  "max_length": 20,  "nullable": true },
    { "name": "message",         "type": "text",    "nullable": true },
    { "name": "date_arrivee",    "type": "date",    "nullable": true },
    { "name": "date_depart",     "type": "date",    "nullable": true },
    { "name": "nombre_personnes","type": "integer", "nullable": true },
    { "name": "statut",          "type": "string",  "max_length": 30,  "nullable": false },
    { "name": "created_at",      "type": "datetime", "nullable": true }
  ],
  "options": { "timestamps": false, "soft_delete": false }
}
