{
  "$schema": "../../../../../../../../schemas/entity.schema.json",
  "schema_version": "1.0",
  "name": "Hebergement",
  "table": "hebergement",
  "description": "Hébergement publié dans le démonstrateur",
  "fields": [
    { "name": "titre",           "type": "string",  "max_length": 200, "nullable": false },
    { "name": "slug",            "type": "string",  "max_length": 200, "unique": true, "nullable": false },
    { "name": "description",     "type": "text",    "nullable": true },
    { "name": "adresse",         "type": "string",  "max_length": 255, "nullable": true },
    { "name": "capacite",        "type": "integer", "nullable": true },
    { "name": "commune_id",      "type": "integer", "nullable": true },
    { "name": "proprietaire_id", "type": "integer", "nullable": true },
    { "name": "is_published",    "type": "boolean", "nullable": false },
    { "name": "created_at",      "type": "datetime", "nullable": true },
