.venv/
.claude/settings.local.json
.kilo/
TestForge101/
# Artefacts de déploiement générés par `forge deploy:init` (ADR-044 : le dépôt
# framework ne porte pas d'application déployée ; ces fichiers se régénèrent
# dans le projet utilisateur).
deploy/
__pycache__/
*.pyc
.pytest_cache/
.vscode/*
!.vscode/settings.json
env/dev
env/prod
env/test
# Secrets de provisioning DB (ENV-PROD-DB-ADMIN-SECRETS-POLICY-001).
# Fichiers locaux non commités pour DB_ADMIN_* en production —
# voir docs/production-security.md.
env/*.local
mvc/models/sql/dev/
mvc/models/sql/prod/
.test
test.py
node_modules/
cert.pem
key.pem
dist/
build/
*.egg-info/
.mypy_cache/
.ruff_cache/
site/
.codex
core design/
.tmp_*/
storage/uploads/*
!storage/uploads/.gitkeep
storage/logs/*
!storage/logs/.gitkeep
storage/mail/*
!storage/mail/.gitkeep
# artefacts runtime ecrits sous core/ lors des tests (logs d'erreurs dev)
core/storage/
sample.json
!storage/uploads/images/
!storage/uploads/images/.gitkeep
storage/uploads/images/thumbnail/
storage/uploads/images/medium/
!storage/uploads/documents/
!storage/uploads/documents/.gitkeep
!storage/uploads/tmp/
!storage/uploads/tmp/.gitkeep
forge-tests-terrain-roadmap.zip

# Fixture d'application de test (ADR-044) : env/storage dynamiques non versionnés
# (seul env/example est suivi ; pas de secrets ni de contenu d'upload).
tests/fixtures/app/env/dev
tests/fixtures/app/env/prod
tests/fixtures/app/env/test
tests/fixtures/app/env/*.local
tests/fixtures/app/storage/uploads/*
tests/fixtures/app/storage/logs/*
tests/fixtures/app/storage/mail/*

# dossier de travail : documents a traiter (contenu ignore, dossier conserve)
tmp/*
!tmp/.gitkeep
