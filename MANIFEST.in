recursive-include cli/schemas *.json

# PKG-WHEEL-NO-PYC-001 — ne jamais embarquer de bytecode compilé dans les
# artefacts (wheel/sdist). Garantit des distributions propres et
# reproductibles, indépendantes du poste de build.
global-exclude *.pyc
global-exclude *.pyo
recursive-exclude * __pycache__

# PKG-SDIST-TESTS-DECISION-001 — la suite de tests Forge est un outil de
# développement (elle s'exécute depuis le monorepo avec les opt-ins en
# éditable, cf. requirements-dev.txt). Elle n'a pas sa place dans le sdist
# distribué : on l'exclut pour alléger l'archive et ne pas exposer
# l'interne. Les tests restent versionnés dans le dépôt.
prune tests
