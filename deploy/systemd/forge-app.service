[Unit]
Description=Forge Application
After=network.target mariadb.service

[Service]
Type=simple
# Gabarit à adapter avant installation.
# Remplacer /opt/forge par le répertoire réel de déploiement, et User par
# l'utilisateur système dédié qui exécutera l'application.
User=www-data
WorkingDirectory=/opt/forge
ExecStart=/opt/forge/.venv/bin/python /opt/forge/app.py --env prod
Restart=always
RestartSec=5
EnvironmentFile=/opt/forge/env/prod

[Install]
WantedBy=multi-user.target
