{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(pytest)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m compileall:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mkdocs build:*)",
      "Bash(mkdocs serve:*)",
      "Bash(forge:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git tag -d:*)",
      "Bash(git push --delete:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/forge-write-if-new.sh\""
          }
        ]
      }
    ]
  }
}
