{
  "sqltools.connections": [
    {
      "name": "Forge Dev (forge_app)",
      "driver": "MariaDB",
      "server": "localhost",
      "port": 3306,
      "database": "forge_db",
      "username": "forge_app",
      "password": "${env:FORGE_DB_APP_PWD}"
    },
    {
      "name": "Forge Dev (forge_admin)",
      "driver": "MariaDB",
      "server": "localhost",
      "port": 3306,
      "database": "forge_db",
      "username": "forge_admin",
      "password": "${env:FORGE_DB_ADMIN_PWD}"
    }
  ],
  "json.schemas": [
    {
      "fileMatch": [
        "/mvc/entities/relations.json"
      ],
      "url": "./schemas/relations.schema.json"
    },
    {
      "fileMatch": [
        "/mvc/entities/*/*.json"
      ],
      "url": "./schemas/entity.schema.json"
    },
    {
      "fileMatch": [
        "/mvc/security/rbac.json"
      ],
      "url": "./schemas/rbac.schema.json"
    }
  ]
}
