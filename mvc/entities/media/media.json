{
  "$schema": "../../../schemas/entity.schema.json",
  "schema_version": "1.0",
  "name": "Media",
  "table": "media",
  "description": "Socle generique Media v2 pour lier un fichier stocke a une entite applicative.",
  "fields": [
    {
      "name": "entity_name",
      "type": "string",
      "max_length": 100,
      "required": true
    },
    {
      "name": "entity_id",
      "type": "integer",
      "required": true,
      "min": 1
    },
    {
      "name": "path",
      "type": "string",
      "max_length": 500,
      "required": true
    },
    {
      "name": "original_name",
      "type": "string",
      "max_length": 255,
      "required": true
    },
    {
      "name": "mime_type",
      "type": "string",
      "max_length": 120,
      "required": true
    },
    {
      "name": "size",
      "type": "integer",
      "required": true,
      "min": 0
    },
    {
      "name": "role",
      "type": "string",
      "max_length": 50,
      "required": true,
      "default": "default"
    },
    {
      "name": "position",
      "type": "integer",
      "required": true,
      "default": 0,
      "min": 0
    },
    {
      "name": "alt_text",
      "type": "string",
      "max_length": 255,
      "nullable": true
    },
    {
      "name": "created_at",
      "type": "datetime",
      "required": true
    }
  ],
  "options": {
    "timestamps": false,
    "soft_delete": false
  }
}
